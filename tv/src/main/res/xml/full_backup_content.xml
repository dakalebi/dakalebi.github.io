<?xml version="1.0" encoding="utf-8"?>
<!-- The Android 8 to 11 twin of data_extraction_rules.xml. allowBackup="false" already
     stops every backup there; this keeps the WebView storage out even if it is ever
     turned back on. Same rule as there: one exclude per domain. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
