<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device, on Android 12+ (see the manifest). Every domain is listed
     because an exclude matches one exact path and each domain is walked from its own
     directory: `root` alone would still let `file`, `database` and `sharedpref` through.
     The WebView storage, Firebase's refresh token included, lives under `root`
     (app_webview). An empty section would mean "everything", not "nothing". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
