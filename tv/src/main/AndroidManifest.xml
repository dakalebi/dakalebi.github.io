<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The shell loads a remote page, so it needs the network and needs to know
         when the network comes back (to auto-reload the error screen). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Marks this a TV app; the Leanback launcher filters on it. `required=true`
         because the app is only meant for a television. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!-- A television has no touchscreen. Without `required=false` the app would be
         filtered off every TV in the Play catalogue and by some sideload installers. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@style/Theme.DakalebiTv">

        <!-- The app loads one known site, so Google's per-navigation Safe Browsing
             check is pure overhead here (a network round-trip and a background service
             at startup). Turning it off shaves startup and navigation latency. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|navigation|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Puts the app on the Android TV home row. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- Keeps it visible on non-TV / sideload launchers too. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
