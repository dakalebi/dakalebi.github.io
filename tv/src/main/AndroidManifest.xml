<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The shell loads a remote page, so it needs the network and needs to know
         when the network comes back (to auto-reload the error screen). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Marks this a TV app; the Leanback launcher filters on it. `required=true`
         because the app is only meant for a television. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!-- A television has no touchscreen. Without `required=false` the app would be
         filtered off every TV in the Play catalogue and by some sideload installers. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- allowBackup is off because the WebView's storage holds the Firebase refresh
         token, and Auto Backup would copy it off the device.

         enableOnBackInvokedCallback makes Back one path on Android 13+: the callback
         MainActivity registers (the key-up that still follows it arrives cancelled).
         Android 16 does that anyway for an app targeting API 36; opting in gives
         Android 13 to 15 the same behaviour instead of a second, different one. -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@style/Theme.DakalebiTv"
        tools:targetApi="tiramisu">

        <!-- The app loads one known site, so Google's per-navigation Safe Browsing
             check is pure overhead here (a network round-trip and a background service
             at startup). Turning it off shaves startup and navigation latency. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|navigation|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Puts the app on the Android TV home row. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- Keeps it visible on non-TV / sideload launchers too. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
