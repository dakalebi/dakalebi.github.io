rules_version = '2';

// There is no backend: the app is a static bundle on GitHub Pages and talks to
// Firestore directly from the browser. These rules ARE the security boundary,
// so they are deliberately restrictive.
service cloud.firestore {
  match /databases/{database}/documents {

    // Who may rebuild the episode catalog.
    //
    // Membership is the existence of admins/{uid}. That collection is readable
    // only by the account it names and writable by NOBODY - entries are created
    // by hand in the Firebase console.
    //
    // That write-deny is the whole design. The obvious alternative, a flag on
    // users/{uid}, cannot work: that document has to be writable by its owner
    // for their settings, so an isAdmin field sitting on it would be a field
    // the user could set on themselves.
    //
    // exists() runs server-side and bypasses these rules, so it can see a
    // document the requesting client cannot read.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Episode catalog: readable by any signed-in user, writable only by admins
    // (this is what the Reload button writes).
    match /episodes/{episodeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Catalog metadata: last refresh time, counts.
    match /meta/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // The admin roster. Read your own entry to know whether to draw the
    // refresh control; nobody writes here from the client.
    match /admins/{adminUid} {
      allow read: if isSignedIn() && request.auth.uid == adminUid;
      allow write: if false;
    }

    // Account settings: one small document per user, written when someone flips
    // a switch in the drawer.
    //
    // The field allowlist is the point of this rule, not the ownership check. A
    // client allowed to write its own document is otherwise allowed to write
    // *anything* into it, and this is a free tier with a shared quota. It also
    // stops a future privileged field being smuggled in here - which is exactly
    // why admin rights live in their own write-denied collection above.
    //
    // hasOnly permits a subset, so a write that touches only one setting passes
    // and leaves the other alone.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.keys()
          .hasOnly(['language', 'autoplayNext', 'updatedAtMillis'])
        && (!('autoplayNext' in request.resource.data)
          || request.resource.data.autoplayNext is bool)
        && (!('language' in request.resource.data)
          || request.resource.data.language is string);
    }

    // Watch progress is strictly private to its owner. A rule of its own rather
    // than an extension of the one above: rules do not cascade into
    // subcollections, so these two paths are matched independently.
    match /users/{userId}/progress/{episodeId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
