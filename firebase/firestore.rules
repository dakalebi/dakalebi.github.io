rules_version = '2';

// There is no backend: the app is a static bundle on GitHub Pages and talks to
// Firestore directly from the browser. These rules ARE the security boundary,
// so they are deliberately restrictive.
service cloud.firestore {
  match /databases/{database}/documents {

    // Who may rebuild the episode catalog.
    //
    // Keyed on the verified email rather than the UID: a UID only exists after
    // an account has signed in at least once, which would leave the very first
    // deploy unable to populate itself. `email_verified` matters - without it a
    // password account could be registered with someone else's address and
    // would inherit admin rights.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['bachanamosulishvili@gmail.com'];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Episode catalog: readable by any signed-in user, writable only by admins
    // (this is what the Reload button writes).
    match /episodes/{episodeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Catalog metadata: last refresh time, counts.
    match /meta/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Watch progress is strictly private to its owner.
    match /users/{userId}/progress/{episodeId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
