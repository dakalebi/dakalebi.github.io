rules_version = '2';

// There is no backend: the app is a static bundle on GitHub Pages and talks to
// Firestore directly from the browser. These rules ARE the security boundary,
// so they are deliberately restrictive.
service cloud.firestore {
  match /databases/{database}/documents {

    // Who may rebuild the episode catalog.
    //
    // UID first. The email branch was originally the only one, to solve a
    // bootstrap problem: a UID does not exist until an account has signed in
    // once, so the very first deploy could not have populated itself. That is
    // history now, and the `email_verified` condition it depends on locked the
    // owner out the moment they moved from Google sign-in to an email/password
    // account created in the console, which Firebase does not mark verified.
    //
    // The email branch stays as a recovery path if the UID ever changes. It is
    // not a weakening: `email_verified` still guards it, so a password account
    // registered against someone else's address matches neither branch.
    function isAdmin() {
      return request.auth != null
        && (
          request.auth.uid in ['PZ6HS4qhStUv8Ai1VxCGU72bW6G3']
          || (
            request.auth.token.email_verified == true
            && request.auth.token.email in ['bachanamosulishvili@gmail.com']
          )
        );
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Episode catalog: readable by any signed-in user, writable only by admins
    // (this is what the Reload button writes).
    match /episodes/{episodeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Catalog metadata: last refresh time, counts.
    match /meta/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Account settings: one small document per user, written when someone flips
    // a switch in the drawer.
    //
    // The field allowlist is the point of this rule, not the ownership check. A
    // client allowed to write its own document is otherwise allowed to write
    // *anything* into it, and this is a free tier with a shared quota.
    // `autoplayNext` is listed ahead of the code that writes it so moving that
    // setting off the device later needs no second rules deploy — `hasOnly`
    // permits a subset, so a write that omits the field still passes.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.keys()
          .hasOnly(['language', 'autoplayNext', 'updatedAtMillis']);
    }

    // Watch progress is strictly private to its owner. A rule of its own rather
    // than an extension of the one above: rules do not cascade into
    // subcollections, so these two paths are matched independently.
    match /users/{userId}/progress/{episodeId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
