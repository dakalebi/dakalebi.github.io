# Kotlin/JS — the yarn lockfile IS committed so CI resolves the same npm tree.
node_modules/
kotlin-js-store/*
!kotlin-js-store/yarn.lock

# Claude Code — launch.json is shared, local permissions are not.
.claude/settings.local.json

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# Local secrets. The Firebase web config is public by design and IS committed
# (src/jsMain/kotlin/ge/dakalebi/firebase/FirebaseConfig.kt); this is only for
# service-account keys used by the optional nightly refresh action.
serviceAccount*.json
*.local
